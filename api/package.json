  "main": "./src/app.ts",
  "scripts": {
    "start": "npm run db:migrate && tsx ./src/app.ts",
    "start:pretty": "npm run db:migrate && tsx src/app.ts | pino-pretty",
    "test": "vitest run | pino-pretty",
    "test:integration": "TEST_DATABASE_URL=\"${TEST_DATABASE_URL:-$POSTGRESQL_CONNECTION_STRING}\" node --import tsx --test test/integration.test.ts",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:status": "tsx src/db/migrate.ts status"
  },
