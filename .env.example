# Local Docker Compose database settings (change the password before deployment).
POSTGRES_USER=safeway
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=safeway_analytics
POSTGRES_PORT=5432
API_PORT=4000

# API settings
NODE_ENV=development
PORT=4000
PINO_LOG_LEVEL=info
POSTGRESQL_CONNECTION_STRING=postgresql://safeway:change-this-local-password@db:5432/safeway_analytics

JWT_SECRET=change-this-local-jwt-secret
JWT_REFRESH_SECRET=change-this-local-jwt-refresh

ADMIN_EMAIL=some@email.com
ADMIN_PASSWORD=Some_password_2004

EMAIL=The-Email
EMAIL_PASSWORD=The-Password

# Dashboard build/runtime settings
DASHBOARD_PORT=8080
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:4000
